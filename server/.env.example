NODE_ENV=development
PORT=5000

# PostgreSQL / Neon / Supabase etc.
DATABASE_URL=postgresql://user:password@host:5432/ignited_brains
DATABASE_SSL=true
DB_POOL_MAX=10

# Comma-separated frontend origins. Required in production.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1

# Admin auth. Use a long random value (minimum 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
JWT_ISSUER=ignited-brains-api
JWT_AUDIENCE=ignited-brains-admin

# Resend. Verify RESEND_FROM in your Resend account/domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=Ignited Brains <notifications@yourdomain.com>
NOTIFICATION_TO=team@yourdomain.com

# Only used by `npm run admin:create`.
ADMIN_NAME=Ignited Brains Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
